# Copy to .env.local and fill in.

# Postgres with the pgvector extension. Any Postgres will do — Supabase is one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/faceapp

# Signs session cookies and storage URLs. Generate with:
#   openssl rand -base64 48
# No default, deliberately: a signing secret that falls back to a constant lets
# anyone mint signed URLs for a stranger's photographs.
APP_SECRET=

# Salts the IP hash in search_logs. Separate from APP_SECRET so it can be
# rotated on its own, which is the point of a salted hash.
IP_HASH_SECRET=

# Where the local storage driver writes. Used only when R2 is not configured.
STORAGE_ROOT=.storage

# Cloudflare R2. All four or none — a partially configured R2 falls back to the
# local filesystem, and on a serverless host that means uploads appear to
# succeed and the photographs are gone by the next request. See
# docs/DEPLOYMENT.md.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=faceapp-photos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# The Python enrollment service.
#   cd ml && uvicorn faceapp_worker.service:app --port 8000
ML_SERVICE_URL=http://127.0.0.1:8000

# Shared secret for that service. The same value must be set on the container.
# No default: unauthenticated, it is an endpoint that turns face photographs
# into biometric templates for anyone who can reach it.
#   openssl rand -base64 32
ML_SERVICE_TOKEN=

SIGNED_URL_TTL_SECONDS=900
SEARCH_RATE_LIMIT_PER_HOUR=3

# There is no environment variable for running on untuned thresholds. Search is
# gated per event: create an event with the demonstration box ticked and it will
# search on placeholder numbers, capped at 30 days and labelled as untrustworthy
# everywhere it appears. A normal event refuses until thresholds are measured.
# See ml/eval/README.md.
